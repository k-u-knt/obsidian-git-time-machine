{
  "name": "obsidian-git-time-machine",
  "version": "0.2.0",
  "description": "Scrub through your vault's Git history (as committed by Obsidian Git), compare notes and canvases side by side, rendered the way Obsidian renders them, and restore whole versions, single blocks or selected canvas cards.",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit -p . && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "install-vault": "npm run build && node scripts/install-to-vault.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "git",
    "history",
    "diff",
    "canvas"
  ],
  "author": "Kenta Ninomiya",
  "license": "MIT",
  "dependencies": {
    "@codemirror/merge": "6.12.2",
    "diff": "9.0.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.0",
    "esbuild": "0.28.2",
    "jsdom": "^26.1.0",
    "obsidian": "1.14.4",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
